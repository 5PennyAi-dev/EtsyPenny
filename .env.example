# Supabase client (safe to expose through Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Supabase server key (server only)
SUPABASE_SECRET_KEY=sb_secret_example

# Supabase Edge runtime only. SUPABASE_SECRET_KEYS is provided by Supabase;
# The backend calls Edge Functions with the secret key named "vercel".
# Edge Functions use "edge_functions" for privileged database access.
PENNYSEO_SUPABASE_SECRET_KEY_NAME=edge_functions
PENNYSEO_EDGE_CALLER_KEY_NAME=vercel

# AI providers
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_API_KEY=replace-me

# DataForSEO
DATAFORSEO_LOGIN=replace-me
DATAFORSEO_PASSWORD=replace-me

# Etsy OAuth
ETSY_API_KEY=replace-me
ETSY_SHARED_SECRET=replace-me
ETSY_OAUTH_REDIRECT_URI=http://localhost:3000/api/etsy/oauth/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
STRIPE_PRICE_STARTER_MONTHLY=price_example
STRIPE_PRICE_STARTER_YEARLY=price_example
STRIPE_PRICE_GROWTH_MONTHLY=price_example
STRIPE_PRICE_GROWTH_YEARLY=price_example
STRIPE_PRICE_PRO_MONTHLY=price_example
STRIPE_PRICE_PRO_YEARLY=price_example
STRIPE_PRICE_PACK_50=price_example
STRIPE_PRICE_PACK_150=price_example
STRIPE_PRICE_PACK_500=price_example

# Application services
APP_URL=http://localhost:5173
API_PORT=3001
RESEND_API_KEY=re_example
VITE_SENTRY_DSN=https://public@example.invalid/1
